# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Neon: the POOLED connection string (host contains "-pooler"). Used by the app.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon: the DIRECT connection string. Used only by migrations and CLI scripts.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Your public URL, e.g. https://label-nova.vercel.app (optional on Vercel; recommended once you have a domain)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (optional). Without RESEND_API_KEY, reset emails are printed to the server log in development.
RESEND_API_KEY=
EMAIL_FROM="Label Nova <noreply@yourdomain.com>"
# EMAIL_TRANSPORT=console

# Deploys make sure this existing account is an active ADMIN. Deploys never set or change passwords.
ADMIN_EMAIL=

# Vercel PREVIEW environment only: a separate database (e.g. a Neon branch). Preview deployments never
# use DATABASE_URL. Leave unset and previews run without a database.
# PREVIEW_DATABASE_URL=
# PREVIEW_DATABASE_URL_UNPOOLED=

# Only for `npm run db:seed` (never in production)
# ALLOW_SEED=true
